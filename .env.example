# tmo-cli configuration
# Copy to .env and fill in. NEVER commit .env.

# T-Mobile ID credentials (the DIGITS line)
TMOBILE_USERNAME=
TMOBILE_PASSWORD=

# Display name for outgoing messages (optional)
TMO_DISPLAY_NAME=DIGITS User

# OpenAI — needed for `tmo ai-call` (voice) and `tmo respond` (text agent)
OAI_API_KEY=

# Auto-responder allowlist — the ONE 10-digit number whose texts get AI
# replies (safety rail: every other sender is logged and ignored)
TMO_RESPOND_TO=

# Daytona sandbox — only needed for sandboxed API execution (optional)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
